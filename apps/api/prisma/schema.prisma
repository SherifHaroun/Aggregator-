// Prisma schema for the internal insurance aggregator.
//
// ============================================================================
//  ARCHITECTURAL RULE
// ============================================================================
// The database is the single source of truth for all insurance information.
//
// No benefit is ever a column. There is deliberately NO `dentalCare`,
// `maternity` or `outpatientCare` field anywhere in this file. Benefits are
// rows in `InsuranceOption`, the information each benefit requires is rows in
// `OptionField`, and the values a plan gives them are rows in
// `PlanOptionValue`.
//
// An employee can therefore invent an entirely new benefit — with entirely new
// fields — from the website, without a schema change, a migration or a deploy.
//
// There is NO seed data and none should ever be added.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The kinds of information an option field can hold.
/// SYSTEM CONFIGURATION, not insurance data — mirrored by
/// `OPTION_FIELD_DATA_TYPES` in @aggregator/shared.
enum OptionFieldDataType {
  NUMBER
  PERCENTAGE
  CURRENCY
  TEXT
  BOOLEAN
  /// One entry from the FIELD's own ranked list — see `OptionChoice`.
  /// Stored as the chosen entry's ID, never its position.
  RANK
  /// SEVERAL entries from that list, e.g. what an inpatient stay includes.
  /// The ticked rows live in `PlanOptionValueChoice`.
  MULTI
}

/// Who a configuration is priced for.
/// SYSTEM CONFIGURATION, mirrored by `CUSTOMER_TYPES` in @aggregator/shared.
/// `src/lib/enum-parity.ts` fails the build if the two ever diverge.
/// There is deliberately no COUPLE value.
enum CustomerType {
  INDIVIDUAL
  FAMILY
  SME
}

/// Where a variant provides cover.
///
/// SYSTEM CONFIGURATION, mirrored by `GEOGRAPHICAL_COVERAGES` in
/// @aggregator/shared. A LIST THAT GROWS: adding a scope means an entry there,
/// a value here, and a migration — `src/lib/enum-parity.ts` fails the build on
/// anything less.
///
/// An enum rather than a table because the comparison FILTERS on it: an
/// employee inventing "Locl" would quietly stop matching plans, and Postgres
/// refusing it outright is worth the migration.
enum GeographicalCoverage {
  LOCAL
  INTERNATIONAL
  LOCAL_AND_INTERNATIONAL
  WORLDWIDE
  /// A scope the list does not yet name. Says nothing about WHERE, so a
  /// comparison can only treat it as "not one of the above".
  OTHER
}

// ============================================================================
//  COMPANIES
// ============================================================================

/// An insurance company. Plans belong to a company.
model Company {
  id          String  @id @default(cuid())
  name        String  @unique
  shortName   String?
  logoUrl     String?
  description String?
  website     String?
  email       String?
  phone       String?
  mobile      String?
  address     String?

  /// Soft delete: deactivated companies keep their history and stay referenced
  /// by existing plans, but are hidden from selection lists.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans Plan[]

  /// The provider networks THIS company sells, in the order it ranks them.
  medicalNetworks CompanyMedicalNetwork[]

  @@index([isActive])
  @@map("companies")
}

/// A provider network belonging to ONE insurance company.
///
/// A network is not a benefit. "Golden Care Network" is not something a plan
/// covers — it is the estate of hospitals and clinics the company sells access
/// to, and every plan that company offers picks one of them. Modelling it as a
/// benefit meant re-typing the same few names on every plan of every company
/// and left no place to say that one company's network outranks another's.
///
/// `sortOrder` is the company's own ranking of its networks, best first.
model CompanyMedicalNetwork {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The priced variants sold on this network.
  ///
  /// A VARIANT, not a plan: the same plan is routinely sold on two networks at
  /// two prices, which is a fact about the priced row and not about the
  /// product. Attaching the network to the plan made those two offerings two
  /// plans with the network smuggled into their names.
  configurations PlanConfiguration[]

  /// What this network actually gives access to, entered once here and read by
  /// every variant sold on it.
  providers NetworkProvider[]

  /// One company cannot sell two networks of the same name.
  @@unique([companyId, name])
  @@index([companyId, sortOrder])
  @@map("company_medical_networks")
}

/// One category of provider in a network's estate — hospitals, pharmacies,
/// laboratories and the rest.
///
/// ROWS RATHER THAN TEN COLUMNS, so a category nobody anticipated is data. The
/// legacy system had exactly ten columns and no way to add an eleventh.
///
/// A document may give a NUMBER ("1,240 hospitals") or WORDING ("all major
/// hospitals in Greater Cairo"), and different insurers give different ones for
/// the same category. Both are therefore available and neither is required:
/// `count` sorts and compares, `detail` says what a number cannot.
model NetworkProvider {
  id        String                @id @default(cuid())
  networkId String
  network   CompanyMedicalNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  /// Employee-facing category name, e.g. "Hospitals".
  category  String
  /// How many, where the document states a figure.
  count     Int?
  /// The wording, where it states one instead of — or as well as — a figure.
  detail    String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A network states each category at most once.
  @@unique([networkId, category])
  @@index([networkId, sortOrder])
  @@map("network_providers")
}

// ============================================================================
//  INSURANCE TYPES
// ============================================================================

/// A category of insurance (medical, life, motor, ...) — a record, never a
/// hardcoded enum, so employees can add new categories from the website.
///
/// It categorises plans. Benefits are NOT scoped by it: one global catalogue is
/// offered to every plan, whatever its type — see `InsuranceOption`.
model InsuranceType {
  id          String  @id @default(cuid())
  name        String  @unique
  /// Stable machine key, e.g. derived from the name. Unique and immutable.
  code        String  @unique
  description String?
  sortOrder   Int     @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans Plan[]

  @@index([isActive])
  @@map("insurance_types")
}

// ============================================================================
//  OPTIONS (the benefit catalogue)
// ============================================================================

/// A benefit/feature an employee has defined, e.g. outpatient care, dental
/// care, physiotherapy, telemedicine — or anything invented in the future.
///
/// GLOBAL: a benefit is defined once and is then offered to every company and
/// every plan. It deliberately carries no company and no insurance type, which
/// is what makes "Outpatient Care" one record rather than one per company.
///
/// What differs between companies is the VALUE the benefit takes, and that
/// lives on `PlanOptionValue` — keyed by `PlanOption`, which belongs to a
/// single plan configuration. So one benefit supports 80% for one company and
/// 70% for another with no duplication.
model InsuranceOption {
  id String @id @default(cuid())

  /// Unique across the whole catalogue: creating a benefit that already exists
  /// is refused rather than duplicated.
  ///
  /// Uniqueness ignores case — "Dental" and "dental" are one benefit. That is
  /// enforced by a second, case-folded unique index that Prisma cannot express
  /// here; see the `case_insensitive_benefit_names` migration.
  name        String  @unique
  description String?
  /// Display order of the option in the catalogue.
  sortOrder   Int     @default(0)

  /// An UMBRELLA groups other benefits and carries no value of its own, e.g.
  /// "Life & Accident Coverage" over death, disability and the rest. It is
  /// created with no `OptionField`, so there is nothing to fill in on it; the
  /// sub-benefits underneath are ordinary benefits that happen to have a
  /// parent.
  isUmbrella Boolean @default(false)

  /// The umbrella this benefit sits under. `null` for a top-level benefit.
  ///
  /// One level deep on purpose: a sub-benefit cannot itself be an umbrella, so
  /// every screen can render the whole catalogue without recursion. The service
  /// enforces that; `onDelete: Restrict` stops an umbrella disappearing out
  /// from under its children.
  parentId String?
  parent   InsuranceOption?  @relation("BenefitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children InsuranceOption[] @relation("BenefitHierarchy")

  /// Deactivate rather than delete once the option is used by any plan.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The information THIS option requires. Every option defines its own.
  /// An umbrella defines none.
  fields      OptionField[]
  planOptions PlanOption[]

  @@index([isActive])
  @@index([parentId, sortOrder])
  @@map("insurance_options")
}

/// One piece of information an option requires, defined by an employee.
///
/// This is what makes options self-describing: "Maternity Care" may define
/// coverage percentage, annual limit and waiting period, while "Doctor Visits"
/// defines maximum visits and coverage percentage. Neither shape is known to
/// the code.
model OptionField {
  id       String          @id @default(cuid())
  optionId String
  option   InsuranceOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  /// Employee-facing name, e.g. "Coverage Percentage".
  label      String
  /// Stable machine key, unique within the option, e.g. "coverage_percentage".
  key        String
  dataType   OptionFieldDataType
  /// Display unit, e.g. "%", "months", "sessions". Optional.
  unit       String?
  helpText   String?
  /// Whether a plan must supply this value for the option to be complete.
  isRequired Boolean             @default(false)
  sortOrder  Int                 @default(0)

  /// An ADDITIONAL CONDITION rather than a core field.
  ///
  /// Core fields are shown the moment the benefit is opened. A condition is a
  /// toggle, and its input appears only once the employee turns it on — because
  /// a document that never mentions a co-payment should not put an empty
  /// co-payment box in front of anybody.
  ///
  /// The toggle's state is not a column: A ROW IN `PlanOptionValue` IS THE
  /// TOGGLE. Present means the condition applies (its value may still be
  /// blank); absent means the document did not state it. One fact, one place.
  isOptional Boolean @default(false)

  /// The condition this input belongs to, for conditions that need more than
  /// one box — "1 in 20 members", "10 sessions per year", "every 12 sessions".
  ///
  /// One level deep: a sub-input cannot own further inputs. Turning the parent
  /// off removes its inputs with it.
  parentFieldId String?
  parentField   OptionField?  @relation("ConditionInputs", fields: [parentFieldId], references: [id], onDelete: Cascade)
  subFields     OptionField[] @relation("ConditionInputs")

  /// Show this input only when the parent's answer is THIS one.
  ///
  /// What turns a dropdown into a complete answer. "Other" is not an answer on
  /// its own — it means "none of these, and here is what it actually is" — so
  /// picking it reveals the box that says. The same mechanism reveals the
  /// procedure checklist under "Specific procedures", and the conditions box
  /// under "Subject to conditions".
  ///
  /// `null` on an input that belongs to a condition rather than to an answer:
  /// those appear whenever their condition is switched on.
  showWhenChoiceId String?
  showWhenChoice   OptionChoice? @relation("AnswerReveals", fields: [showWhenChoiceId], references: [id], onDelete: Cascade)

  /// Which customer types this setting applies to. EMPTY MEANS ALL OF THEM.
  ///
  /// Some questions only exist for some buyers: a member ratio — "one in twenty
  /// members" — is a rule about a group, and an individual policy has no group.
  /// Showing it on an individual plan invites an answer that cannot be true.
  customerTypes CustomerType[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values PlanOptionValue[]

  /// The answers THIS setting offers, ranked. Only RANK and MULTI use them:
  /// the list belongs to the setting, because "in-network only" qualifies a
  /// coverage percentage and has nothing to say about a room type.
  choices         OptionChoice[]
  selectedChoices PlanOptionValueChoice[]

  @@unique([optionId, key])
  @@unique([optionId, label])
  @@index([optionId, isActive])
  @@index([optionId, parentFieldId, sortOrder])
  @@index([showWhenChoiceId])
  @@map("option_fields")
}

/// One answer a benefit offers, in a list the employee puts in order.
///
/// Two jobs, one mechanism, because they are the same thing from two sides:
///
///   - On a RANK benefit the list IS the cover. "Golden Care Network" is not a
///     percentage, but it is plainly better than "Orange Care Network" — and
///     only an employee knows that. They say it once by ordering the list, and
///     every plan quoting a network is then ranked by where it sits.
///   - On a TEXT benefit the list is suggestions. "Covered at authorized
///     centers" gets typed on plan after plan, each time a little differently,
///     and thirty spellings of one answer are thirty answers to any report.
///
/// `sortOrder` is the position, 0 first. A plan stores the CHOSEN ROW'S ID, so
/// reordering this list changes how good an answer is judged to be and never
/// which answer a plan is recorded as giving.
model OptionChoice {
  id            String      @id @default(cuid())
  optionFieldId String
  optionField   OptionField @relation(fields: [optionFieldId], references: [id], onDelete: Cascade)

  label     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Where this answer was ticked on a MULTI setting.
  selectedBy PlanOptionValueChoice[]

  /// Inputs that appear only when THIS answer is the one chosen.
  reveals OptionField[] @relation("AnswerReveals")

  /// The same answer cannot be offered twice by one setting.
  @@unique([optionFieldId, label])
  @@index([optionFieldId, sortOrder])
  @@map("option_choices")
}

/// One answer ticked for a MULTI setting, on one benefit of one configuration.
///
/// The row exists because the answer was ticked; NO ROW MEANS IT WAS NOT. An
/// empty set therefore reads as "the document does not say" — never as
/// "includes nothing", which is a different and much stronger claim.
model PlanOptionValueChoice {
  planOptionId String
  planOption   PlanOption @relation(fields: [planOptionId], references: [id], onDelete: Cascade)

  optionFieldId String
  optionField   OptionField @relation(fields: [optionFieldId], references: [id], onDelete: Cascade)

  choiceId String
  choice   OptionChoice @relation(fields: [choiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([planOptionId, choiceId])
  @@index([choiceId])
  @@index([planOptionId, optionFieldId])
  @@map("plan_option_value_choices")
}

// ============================================================================
//  PLANS
// ============================================================================

/// The insurance PRODUCT a company offers, independent of who buys it and
/// where it applies.
///
/// A plan carries only what is true of the product itself. Anything that can
/// differ between customer types or coverage areas — price, limits, benefits —
/// lives on `PlanConfiguration`, so one product is never split into several
/// plan records.
model Plan {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  insuranceTypeId String
  insuranceType   InsuranceType @relation(fields: [insuranceTypeId], references: [id], onDelete: Restrict)

  name        String
  /// Company-facing plan code. Unique per company.
  code        String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  configurations PlanConfiguration[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([insuranceTypeId, isActive])
  @@map("plans")
}

/// One plan priced and configured for a specific customer type and coverage
/// area — e.g. the same plan sold to an individual locally versus to an SME
/// internationally.
///
/// This is the row the comparison searches. An employee entering
/// "Individual + Local" matches configurations directly, and each result still
/// knows its plan and company through the relation.
///
/// The configuration also declares WHO IT IS FOR by age: `ageFrom`..`ageTo`,
/// inclusive. A plan sold differently to 18-40 year olds and to 41-60 year olds
/// is two configurations, which is why the age band is part of this row's
/// identity. A comparison matches when `ageFrom <= age <= ageTo`.
///
/// The customer's own age is a single number they type; the band is the admin's
/// side of that match. The SME default age remains a business rule in
/// `@aggregator/shared` and is never stored here.
model PlanConfiguration {
  id     String @id @default(cuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  customerType         CustomerType
  geographicalCoverage GeographicalCoverage

  /// The company network THIS variant is sold on, chosen from the plan's own
  /// company list. `null` where the document does not say.
  ///
  /// On the variant rather than the plan, because the same plan is sold on two
  /// networks at two prices — that is the whole reason a plan has variants. On
  /// the plan it forced "Gold (Full Network)" and "Gold (limited Network)" to
  /// be two products.
  medicalNetworkId String?
  medicalNetwork   CompanyMedicalNetwork? @relation(fields: [medicalNetworkId], references: [id], onDelete: SetNull)

  /// The hospital accommodation this variant buys — "Private Room",
  /// "Semi-private Room". Free text, because insurers name it differently and
  /// no list here could be right for all of them.
  ///
  /// It changes the premium, so it belongs to the variant. It is NOT compared:
  /// nothing ranks a room type, and a comparison that did would be inventing a
  /// judgement nobody made.
  roomType String?

  /// Inclusive age band this configuration applies to. Both are required: a
  /// configuration that applies to nobody in particular cannot be matched.
  ageFrom Int
  ageTo   Int

  /// ISO 4217 code, e.g. "EGP". Set per configuration because a local and an
  /// international configuration may well be priced in different currencies.
  currency    String?  @db.VarChar(3)
  annualPrice Decimal? @db.Decimal(14, 2)
  annualLimit Decimal? @db.Decimal(14, 2)
  deductible  Decimal? @db.Decimal(14, 2)
  coPayment   Decimal? @db.Decimal(5, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options PlanOption[]

  /// What makes one variant different from another:
  /// plan, who it is for, where it covers, the network, the room, the ceiling —
  /// and then the age band.
  ///
  /// PostgreSQL treats NULLs as distinct in a unique index, so two variants
  /// that both leave the network, room and ceiling unstated do not collide
  /// here. `plan-configurations.service.ts` refuses those, and is the authority
  /// for the cases this index cannot see.
  ///
  /// Named explicitly: the generated name exceeds Postgres's 63-character
  /// identifier limit and would be silently truncated.
  @@unique([planId, customerType, geographicalCoverage, medicalNetworkId, roomType, annualLimit, ageFrom, ageTo], map: "plan_configurations_identity_key")
  /// The comparison's primary lookup: "every active configuration for this
  /// customer type and coverage area".
  @@index([customerType, geographicalCoverage, isActive])
  /// Supports the comparison's age-band lookup.
  @@index([ageFrom, ageTo])
  @@index([planId, isActive])
  @@index([medicalNetworkId])
  @@map("plan_configurations")
}

// ============================================================================
//  PLAN <-> OPTION
// ============================================================================

/// An option attached to ONE CONFIGURATION — the row created when an employee
/// drags an option onto a configuration of a plan.
///
/// Attaching to the configuration rather than the plan is what lets the same
/// benefit carry different coverage for Individual+Local than for Family+Local.
/// Values can never leak between configurations, because each configuration
/// owns its own `PlanOption` rows and those own their values.
///
/// `sortOrder` is the drag-and-drop position within the configuration.
model PlanOption {
  id                  String            @id @default(cuid())
  planConfigurationId String
  planConfiguration   PlanConfiguration @relation(fields: [planConfigurationId], references: [id], onDelete: Cascade)

  optionId String
  option   InsuranceOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  sortOrder Int @default(0)

  /// A remark about this benefit ON THIS CONFIGURATION, e.g. "1 in 10 members
  /// ratio" or "basic procedures only".
  ///
  /// A column rather than an `OptionField`, because it is not information the
  /// benefit requires: every attachment may carry one, whatever the benefit is,
  /// exactly like `sortOrder`. Its text differs per configuration — the same
  /// benefit reads "1 in 10" on one plan and "1 in 20" on another — which is
  /// why it lives here and not on `InsuranceOption`.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values PlanOptionValue[]

  /// The answers ticked for this benefit's MULTI settings on this
  /// configuration. No row means nothing was recorded.
  selectedChoices PlanOptionValueChoice[]

  /// An option can appear at most once in a configuration.
  @@unique([planConfigurationId, optionId])
  @@index([planConfigurationId, sortOrder])
  @@index([optionId])
  @@map("plan_options")
}

/// The value one option field takes inside one specific plan.
///
/// Values are stored in typed columns rather than a single stringified column,
/// so numbers stay sortable and comparable in SQL. Exactly one column is used,
/// chosen by the field's `dataType`:
///
///   NUMBER / PERCENTAGE / CURRENCY -> numberValue
///   TEXT                           -> textValue
///   BOOLEAN                        -> booleanValue
///
/// This is the row that holds "coverage = 80%" for one option in one plan.
model PlanOptionValue {
  id           String     @id @default(cuid())
  planOptionId String
  planOption   PlanOption @relation(fields: [planOptionId], references: [id], onDelete: Cascade)

  optionFieldId String
  optionField   OptionField @relation(fields: [optionFieldId], references: [id], onDelete: Cascade)

  numberValue  Decimal? @db.Decimal(18, 4)
  textValue    String?
  booleanValue Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One value per field per plan-option.
  @@unique([planOptionId, optionFieldId])
  @@index([optionFieldId])
  @@map("plan_option_values")
}
