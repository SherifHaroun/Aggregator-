# Copy to `.env` and fill in real values. `.env` is git-ignored.

# PostgreSQL connection string used by Prisma.
#
# Neon: use the DIRECT (unpooled) connection string — the host WITHOUT `-pooler`.
# Prisma migrations are unreliable over Neon's pooled endpoint, and the direct
# endpoint needs no `directUrl` entry in schema.prisma.
#   postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/insurance_aggregator?schema=public"

# Separate database (a Neon branch works well) for the database integration
# tests. When set, they run; when absent, they skip. Never point this at the
# database you keep real insurance data in — the suite writes and deletes rows.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# HTTP server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (the web client).
CORS_ORIGINS=http://localhost:5173

# Shared secret required to CHANGE insurance data (POST/PATCH/PUT/DELETE).
# Leave unset while the API is internal-only: writes stay open, as today.
# Set it once a public client can reach this API — the public site never holds
# the token, so it becomes physically unable to modify anything.
# See apps/api/src/middleware/access.ts.
# ADMIN_API_TOKEN="a-long-random-string"
