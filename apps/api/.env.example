# Copy to `.env` and fill in real values. `.env` is git-ignored.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/insurance_aggregator?schema=public"

# HTTP server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (the web client).
CORS_ORIGINS=http://localhost:5173
