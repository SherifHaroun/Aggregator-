# Copy to `.env` and fill in real values. `.env` is git-ignored.

# PostgreSQL connection string used by Prisma.
#
# Production runs on Railway, where the Postgres service injects DATABASE_URL
# into the API service automatically — nothing needs setting there.
#
# Railway's own `DATABASE_URL` points at `postgres.railway.internal`, which
# resolves ONLY inside Railway's private network. To reach that database from a
# development machine the Postgres service needs a TCP proxy, and the public
# endpoint it gives you is what goes here.
#
# For local work, a local PostgreSQL is usually the better answer: it is
# faster, and nothing you do can reach the live data.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/insurance_aggregator?schema=public"

# Separate database for the database integration tests. When set, they run;
# when absent, they skip. Never point this at the database holding real
# insurance data — the suite writes and deletes rows.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aggregator_test?schema=public"

# HTTP server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (the web client).
# In production this is the Vercel origin serving the web app.
CORS_ORIGINS=http://localhost:5173

# Shared secret required to CHANGE insurance data (POST/PATCH/PUT/DELETE).
# Leave unset while the API is internal-only: writes stay open, as today.
# Set it once a public client can reach this API — the public site never holds
# the token, so it becomes physically unable to modify anything.
# See apps/api/src/middleware/access.ts.
# ADMIN_API_TOKEN="a-long-random-string"

# Where uploaded company logos are written. On Railway this is the mounted
# volume; locally it defaults to the repository's own uploads directory.
# UPLOAD_DIR=/data/uploads

# The ONE staff account. An employee signs in on the website with these to
# reach the admin area; anybody else is a customer. Both must be set for
# staff sign-in to work, on Railway as well as locally.
# ADMIN_EMAIL=info@hadbrok.com
# ADMIN_PASSWORD=change-me

# Signs session tokens. Any long random string. Set it in production so
# signing in survives a restart; unset, a fresh secret is drawn at boot and
# everybody is signed out whenever the server restarts.
# SESSION_SECRET=
