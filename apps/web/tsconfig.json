{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  // Building this project builds `@aggregator/shared` first, so its `dist`
  // (which the package's "exports"/"types" point at) exists before the web
  // app resolves it. Without this, a clean checkout — e.g. a Vercel build —
  // fails with TS2307: Cannot find module '@aggregator/shared'.
  "references": [{ "path": "../../packages/shared" }]
}
