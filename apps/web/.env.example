# Copy to `.env` if you need to override defaults. `.env` is git-ignored.

# Base path for API calls. Defaults to /api/v1 (proxied by Vite in development).
VITE_API_BASE_URL=/api/v1

# WHICH SITE THIS BUILD IS. One codebase, two sites, and they can be deployed
# apart on different URLs from the same code:
#   all       both the customer site (/) and the admin (/admin) — the default
#   customer  the customer site only; /admin does not exist on this deployment
#   admin     the employee area only; / leads straight to /admin
# Both talk to the same API and database, so what happens on one is on the
# other the moment it happens.
# VITE_SITE_MODE=all

# When the admin is deployed apart from the customer site, where the customer
# site lives — so the admin's "Customer site" link leads there.
# VITE_CUSTOMER_SITE_URL=https://www.hadbrok.com
