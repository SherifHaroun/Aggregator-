{
  "name": "@aggregator/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared business rules, configuration, types and contracts used by both the API and the web client.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
